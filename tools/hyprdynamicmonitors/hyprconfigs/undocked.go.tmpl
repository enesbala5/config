-- Laptop native mode at 1.56666667 scale => 1440x960 logical.
{{- $laptop := index .MonitorsByTag "laptop" -}}
{{- if $laptop }}
hl.monitor({
	output = "desc:BOE 0x0BCA",
	mode = "2256x1504@59.99900",
	position = "0x0",
	scale = 1.56666667,
	transform = 0,
	vrr = 0,
})

hl.window_rule({ match = { class = "(code)$" }, opacity = "0.95 override 0.90 override 0.95 override" })
hl.window_rule({ match = { title = ".*Cursor.*" }, opacity = "0.95 override 0.90 override 0.95 override" })
hl.window_rule({ match = { class = "(dev.zed.Zed-Nightly)$" }, opacity = "0.95 override 0.90 override 0.95 override" })
hl.window_rule({ match = { class = "(obsidian)$" }, opacity = "0.95 override 0.90 override 0.98 override" })

hl.config({ general = { gaps_out = 5 } })
{{ end }}
