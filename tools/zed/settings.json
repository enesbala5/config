	"use_system_prompts": true,
	"use_system_path_prompts": true,
	"prettier": {
		"allowed": true
	},
	"outline_panel": {
		"button": true,
		"file_icons": true
	},
	"edit_predictions": {
		"mode": "subtle",
		"provider": "codestral",
		"allow_data_collection": "no"
	},
	"cli_default_open_behavior": "new_window",
	"git_panel": {
		"folder_icons": true,
		"dock": "left"
	},
	"agent_servers": {
		"cursor": {
			"type": "registry"
		}
	},
	"icon_theme": {
		"mode": "dark",
		"light": "Catppuccin Frappé",
		"dark": "VSCode Icons"
	},
	"format_on_save": "off",
	"agent": {
		"play_sound_when_agent_done": "when_hidden",
		"inline_assistant_model": {
			"provider": "zed.dev",
			"model": "gpt-5-nano",
			"enable_thinking": false
		},
		"default_profile": "write",
		"profiles": {},
		"dock": "right",
		"tool_permissions": {
			"default": "allow"
		},
		"default_model": {
			"effort": "low",
   "enable_thinking": true,
			"provider": "google",
			"model": "gemini-3-flash-preview"
		},
		"model_parameters": []
	},
	"preview_tabs": {
		"enabled": true
	},
	"tabs": {
		"file_icons": true,
		"git_status": true
	},
	"tab_bar": {
		"show": true
	},
	"terminal": {
		"font_size": 14.0,
		"env": {
			"EDITOR": "\"code\""
		},
		"font_family": "MesloLGS NF"
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"project_panel": {
		"dock": "left",
		"auto_fold_dirs": false
	},
	"base_keymap": "Cursor",
	"minimap": {
		"show": "auto"
	},
	"cursor_blink": true,
	"autosave": {
		"after_delay": {
			"milliseconds": 500
		}
	},
	"confirm_quit": true,
	"buffer_font_fallbacks": ["Fira Code"],
	"buffer_font_family": "Fira Code Retina",
	"file_types": {
		"tailwindcss": ["*.css"],
		"typescriptreact": ["*.tsx"]
	},
	"linked_edits": true,
	"show_edit_predictions": true,
	"preferred_line_length": 144,
	"soft_wrap": "editor_width",
	"hard_tabs": true,
	"tab_size": 2,
	"ui_font_size": 16,
	"buffer_font_size": 13.0,
	"theme": {
		"mode": "system",
		"light": "macOS Classic Light",
		"dark": "VSCode Dark Modern"
	},
	"languages": {
		"Markdown": {
			"show_edit_predictions": false
		},
		"TypeScript": {
			"language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
		},
		"TSX": {
			"language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
		},
		"Nix": {
			"language_servers": ["nixd", "!nil"],
			"formatter": {
				"external": {
					"command": "nixfmt"
				}
			}
		}
	},
	"lsp": {
		"activitywatch": {
			"settings": {
				"host": "127.0.0.1",
				"port": 5600
			}
		},
		"nixd": {
			"initialization_options": {
				"formatting": {
					"command": ["nixfmt"]
				}
			},
			"settings": {
				"diagnostic": {
					"suppress": ["sema-extra-with"]
				}
			}
		}
	}
}
