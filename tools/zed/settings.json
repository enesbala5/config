// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	// "indent_guides": {
	// 	"background_coloring": "indent_aware",
	// },
	"auto_update_extensions": {
		"activitywatch": false
	},
	"ssh_connections": [
		{
			"host": "192.168.0.40",
			"username": "e",
			"args": ["-o", "IdentitiesOnly=no"],
			"projects": [
				{
					"paths": ["/home/e/config"]
				}
			]
		},
		{
			"host": "home-server",
			"args": [],
			"projects": [
				{
					"paths": ["/home/e/config"]
				}
			]
		}
	],
	"disable_ai": false,
	"context_servers": {
		"Polar": {
			"url": "https://mcp.polar.sh/mcp/polar-mcp",
			"enabled": true
		},
		"axiom": {
			"url": "https://mcp.axiom.co/mcp",
			"enabled": true
		},
		"openseo": {
			"url": "https://openseo.enesbala.com/mcp",
			"enabled": true
		},
		"twenty-crm": {
			"command": "/home/e/config/scripts/utilities/mcp-http.sh",
			"args": [
				"https://twenty.enesbala.com/mcp",
				"Authorization: Bearer ${TWENTY_MCP_TOKEN}"
			],
			"env": {},
			"enabled": true
		},
		"coverlttr": {
			"url": "https://mcp.coverlttr.com/mcp",
			"enabled": true
		},
		"coverlttr-dev": {
			"url": "http://localhost:5181/mcp",
			"enabled": true
		},
		"coolify-home": {
			"command": "/home/e/config/scripts/utilities/mcp-http.sh",
			"args": [
				"https://host.enesbala.com/mcp",
				"Authorization: Bearer ${COOLIFY_HOME_TOKEN}"
			],
			"env": {},
			"enabled": true
		},
		"astro-docs": {
			"url": "https://mcp.docs.astro.build/mcp",
			"enabled": true
		},
		"playwright": {
			"command": "/home/e/config/scripts/browser/playwright-mcp.sh",
			"args": [],
			"env": {},
			"enabled": true
		},
		"DbFlux": {
			"command": "/etc/profiles/per-user/e/bin/dbflux",
			"args": [
				"mcp",
				"--client-id",
				"fw-13"
			],
			"env": {},
			"enabled": true
		}
	},
	"inlay_hints": {
		"edit_debounce_ms": 0
	},
	"proxy": "",
	"instrumentation": {
		"performance_profiler": {
			"enabled": false
		}
	},
	"git": {
		"branch_picker": {
			"show_author_name": true
		}
	},
	"diff_view_style": "unified",
	"title_bar": {
		"show_branch_status_icon": false,
		"show_branch_name": true,
		"show_project_items": true,
		"show_sign_in": true,
		"show_user_menu": true,
		"show_user_picture": true,
		"show_menus": false,
		"button_layout": "platform_default"
	},
	"use_system_prompts": true,
	"use_system_path_prompts": true,
	"prettier": {
		"allowed": true
	},
	"outline_panel": {
		"button": true,
		"file_icons": true
	},
	"edit_predictions": {
		"mode": "eager",
		"provider": "zed",
		"allow_data_collection": "no"
	},
	"cli_default_open_behavior": "new_window",
	"git_panel": {
		"tree_view": true,
		"folder_indicator": "icon",
		"dock": "left"
	},
	"agent_servers": {
		"pi-acp": {
			"type": "registry"
		},
		"opencode": {
			"default_config_options": {
				"effort": "default",
				"model": "deepseek/deepseek-flash"
			},
			"type": "registry"
		},
		"cursor": {
			"type": "registry"
		}
	},
	"icon_theme": {
		"mode": "dark",
		"light": "VSCode Icons",
		"dark": "VSCode Icons"
	},
	"format_on_save": "off",
	"agent": {
		"sandbox_permissions": {
			"allow_unsandboxed": true,
			"write_paths": [
				{
					"requested": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/merre",
					"resolved": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/merre"
				},
				{
					"requested": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/coverlttr",
					"resolved": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/coverlttr"
				},
				{
					"requested": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/audiobookshelf",
					"resolved": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/audiobookshelf"
				},
				{
					"requested": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/uptime-kuma",
					"resolved": "/home/e/config/nix/nixos/hosts/home-server/modules/backups/uptime-kuma"
				}
			]
		},
		"play_sound_when_agent_done": "when_hidden",
		"inline_assistant_model": {
			"provider": "zed.dev",
			"model": "gpt-5-nano",
			"enable_thinking": false
		},
		"default_profile": "write",
		"profiles": {},
		"dock": "right",
		"tool_permissions": {
			"default": "allow"
		},
		"default_model": {
			"effort": "medium",
			"enable_thinking": true,
			"provider": "zed.dev",
			"model": "claude-sonnet-4-6"
		},
		"model_parameters": []
	},
	"preview_tabs": {
		"enabled": true
	},
	"tabs": {
		"file_icons": true,
		"git_status": true
	},
	"tab_bar": {
		"show": true
	},
	"terminal": {
		"font_size": 14.0,
		"env": {
			"EDITOR": "\"code\""
		},
		"font_family": "MesloLGS NF"
	},
	"telemetry": {
		"diagnostics": false,
		"metrics": false
	},
	"project_panel": {
		"dock": "left",
		"auto_fold_dirs": false
	},
	"base_keymap": "Cursor",
	"minimap": {
		"show": "auto"
	},
	"cursor_blink": true,
	"autosave": {
		"after_delay": {
			"milliseconds": 500
		}
	},
	"confirm_quit": true,
	"buffer_font_fallbacks": ["Fira Code"],
	"buffer_font_family": "Fira Code Retina",
	"file_types": {
		"tailwindcss": ["*.css"],
		"typescriptreact": ["*.tsx"]
	},
	"linked_edits": true,
	"show_edit_predictions": true,
	"preferred_line_length": 144,
	"soft_wrap": "editor_width",
	"hard_tabs": true,
	"tab_size": 2,
	"ui_font_size": 16,
	"buffer_font_size": 13.0,
	"theme": {
		"mode": "dark",
		"light": "macOS Classic Light",
		"dark": "VSCode Dark Modern"
	},
	"languages": {
		"Markdown": {
			"show_edit_predictions": false
		},
		"TypeScript": {
			"language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
		},
		"TSX": {
			"language_servers": ["typescript-ls", "!vtsls", "!typescript-language-server", "..."]
		},
		"Nix": {
			"language_servers": ["nixd", "!nil"],
			"formatter": {
				"external": {
					"command": "nixfmt"
				}
			}
		}
	},
	"lsp": {
		"activitywatch": {
			"settings": {
				"host": "127.0.0.1",
				"port": 5600
			}
		},
		"nixd": {
			"initialization_options": {
				"formatting": {
					"command": ["nixfmt"]
				}
			},
			"settings": {
				"diagnostic": {
					"suppress": ["sema-extra-with"]
				}
			}
		}
	}
}
